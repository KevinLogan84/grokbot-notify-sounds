{
  // Master switch. false still advances the cursor and plays nothing.
  "enabled": true,

  // Separate from enabled. true plays nothing and speaks nothing, and still advances the cursor.
  "paused": false,

  // Seconds between Notification Center polls. Must be greater than 0.
  "poll_interval_seconds": 2,

  // Bundle id from --list-apps. An empty string matches no app.
  "bundle_id": "",

  // Integer 0–100. afplay volume is (rule volume / 100) * (master_volume / 100).
  "master_volume": 100,

  // Per-rule silence after a play, in seconds. 0 turns cooldown off.
  // A skipped play does not reset the window. Keyed by rule name.
  // Last-played times are stored in the state file.
  "cooldown_seconds": 0,

  // After the first sound in a burst finishes, more than this many items
  // enqueued inside burst_window_seconds collapse into one extra default sound.
  "burst_threshold": 3,
  "burst_window_seconds": 5,

  // Same rule and bot inside this window plays once. Omit the key to use
  // burst_window_seconds. 0 turns dedupe off.
  // "dedupe_window_seconds": 5,

  // Waiting items past this cap are counted into the collapse instead of queued.
  "queue_max": 20,

  // Local time. If start is later than end, the window wraps midnight.
  // mute: no sound and no speech. soft: default sound only, and speech only if default.say is true.
  "quiet_hours": {
    "enabled": false,
    "start": "22:00",
    "end": "07:00",
    "mode": "mute",
  },

  // Fallback when nothing matches. Rule volume falls back here when a rule omits volume.
  // Speech is off unless say is true. Omit say, or set it false.
  "default": {
    "sound": "Tink",
    "volume": 40,
    "say": false,
    "voice": null,
  },

  // First match wins. Put a specific rule above a broader one.
  "rules": [
    {
      // Bot plus text. Both must match.
      "name": "Alfred shipped",
      "bot": "Alfred",
      "regex": "shipped|delivered",
      "match_in": "body",
      "sound": "Hero",
      "volume": 60,
    },
    {
      // Text only. A list matches if any phrase appears.
      "name": "Needs approval",
      "contains": ["approve", "needs your OK"],
      "match_in": "both",
      "sound": "Sosumi",
    },
    {
      // Bot only. Case-insensitive substring of the title or the subtitle.
      "name": "Alfred answers",
      "bot": "Alfred",
      "sound": "Glass",
      "volume": 80,
    },
  ],
}
